<?xml version="1.0" encoding="utf-8"?>
<!-- Política por defecto para futuras versiones con sincronización: sólo HTTPS y CAs del sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
